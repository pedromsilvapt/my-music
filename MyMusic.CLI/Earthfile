VERSION 0.8
FROM mcr.microsoft.com/dotnet/sdk:10.0

WORKDIR /app/MyMusic

ARG --global projects = "MyMusic.CLI"
ARG --global VERSION = "0.0.0"
# Optional repository of the prebuilt base images, see the root Earthfile
ARG --global BASE_IMAGES

# Starts the calling target from its base image: the prebuilt `${BASE_IMAGES}:cli-<name>` when the arg is set, the
# local `+<name>-base` target otherwise. The arg has to be handed over explicitly, functions do not see globals:
#   DO +BASE --name=install --BASE_IMAGES=$BASE_IMAGES
BASE:
    FUNCTION

    ARG --required name
    ARG BASE_IMAGES

    IF [ -n "$BASE_IMAGES" ]
        FROM ${BASE_IMAGES}:cli-$name
    ELSE
        FROM +$name-base
    END

# Compiles the CLI, including the Native AOT toolchain (clang, zlib)
install-base:
    FROM mcr.microsoft.com/dotnet/sdk:10.0

    RUN apt-get update && apt-get install -y --no-install-recommends clang zlib1g-dev && \
        rm -rf /var/lib/apt/lists/*

    # Warm up the NuGet cache, including the runtime specific packages of the Native AOT publish (ILCompiler)
    WORKDIR /tmp/nuget-warmup

    COPY ../+packages-props/Directory.Packages.props ./
    COPY ./MyMusic.CLI.csproj ./MyMusic.CLI/

    RUN dotnet restore ./MyMusic.CLI/MyMusic.CLI.csproj && \
        dotnet restore ./MyMusic.CLI/MyMusic.CLI.csproj -r linux-x64

    RUN rm -rf /tmp/nuget-warmup

    WORKDIR /app/MyMusic

install:
    DO +BASE --name=install --BASE_IMAGES=$BASE_IMAGES

    COPY ../+packages-props/Directory.Packages.props ./

    FOR proj IN $projects
        RUN mkdir -p ./$proj/

        COPY ./$proj.csproj ./$proj/

        RUN dotnet restore ./$proj/$proj.csproj
    END

sources:
    FROM +install

    FOR proj IN $projects
        RUN mkdir -p ./$proj/

        COPY . ./$proj/
    END

# Native AOT (default): ~15x faster startup and a third of the size. The binary links against this image's glibc
# (Ubuntu 24.04, 2.39), so it won't run on older distros (e.g. Debian 12); use +build-jit for those
build-aot:
    FROM +sources

    ARG configuration='Release'

    RUN dotnet publish ./MyMusic.CLI \
        --configuration $configuration \
        -r linux-x64 \
        -o publish

    # Debug symbols are split into my-music.dbg (~35 MB); keep them out of the package
    RUN rm -f publish/*.dbg

    SAVE ARTIFACT publish publish

# Self-contained JIT build (single-file + ReadyToRun): slower startup, but runs on any distro .NET supports
build-jit:
    FROM +sources

    ARG configuration='Release'

    RUN dotnet publish ./MyMusic.CLI \
        --configuration $configuration \
        -r linux-x64 \
        --self-contained true \
        -p:PublishAot=false \
        -p:PublishSingleFile=true \
        -p:EnableCompressionInSingleFile=true \
        -p:PublishReadyToRun=true \
        -p:TieredCompilationQuickJit=true \
        -o publish

    SAVE ARTIFACT publish publish

# Packages the CLI as a .deb (fpm)
package-base:
    FROM mcr.microsoft.com/dotnet/sdk:10.0

    RUN apt-get update && apt-get install -y ruby ruby-dev build-essential && \
        rm -rf /var/lib/apt/lists/*

    RUN gem install fpm

package:
    # Which build to package: aot or jit
    ARG variant='aot'

    DO +BASE --name=package --BASE_IMAGES=$BASE_IMAGES

    WORKDIR /app/MyMusic

    RUN mkdir -p /app/.pkgroot/usr/local/bin /app/.pkgroot/usr/share/my-music

    # Copy the application files
    IF [ "$variant" = "jit" ]
        COPY +build-jit/publish /app/.pkgroot/usr/share/my-music
    ELSE IF [ "$variant" = "aot" ]
        COPY +build-aot/publish /app/.pkgroot/usr/share/my-music
    ELSE
        RUN echo "Unknown variant '$variant' (expected aot or jit)" && false
    END
    RUN chmod 755 /app/.pkgroot/usr/share/my-music/my-music

    # Create the binary link
    RUN ln -s /usr/share/my-music/my-music /app/.pkgroot/usr/local/bin/my-music

    RUN fpm -s dir -t deb \
        --name my-music-cli \
        --version ${VERSION} \
        --description "MyMusic command line interface" \
        --category utils \
        --architecture amd64 \
        --chdir /app/.pkgroot \
        .

    RUN dpkg-deb -c my-music-cli_${VERSION}_amd64.deb

    SAVE ARTIFACT my-music-cli_${VERSION}_amd64.deb

package-test:
    FROM debian:13

    ARG variant='aot'

    COPY (+package/* --variant=$variant) .

    RUN dpkg -i my-music-cli_${VERSION}_amd64.deb

    # Set environment vairable to avoid issue and avoid installing the localization libs here
    # https://learn.microsoft.com/en-us/dotnet/core/runtime-config/globalization#invariant-mode
    RUN DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 \
        my-music --help

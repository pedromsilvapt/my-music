{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "MyMusic": {
    "Server": {
      "BaseUrl": "http://localhost:5000"
    },
    "Device": {
      "Name": "My Laptop",
      "Icon": null,
      "Color": null,
      "NamingTemplate": null
    },
    "Repository": {
      "Path": "",
      "ExcludePatterns": [
        "**/.*",
        "**/Thumbs.db",
        "**/*.tmp",
        "**/desktop.ini"
      ],
      "MusicExtensions": [
        ".mp3"
      ]
    },
    "Sync": {
      "AdaptiveChunks": true,
      "TargetRequestSeconds": 0.5,
      "CheckChunk": {
        "Size": 50,
        "Min": 10,
        "Max": 1000
      },
      "ResolveChunk": {
        "Size": 200,
        "Min": 25,
        "Max": 1000
      },
      "FileModifiedAt": "Now"
    },
    "Logging": {
      "EnableFileLogging": false,
      "FilePath": "mymusic-cli.log"
    }
  },
  "OpenTelemetry": {
    "Enabled": false,
    "Endpoint": "http://localhost:4318",
    "Protocol": "http/protobuf"
  }
}

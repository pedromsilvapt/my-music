<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>my-music</AssemblyName>
        <Version>0.24.1</Version>
        <!-- Only affects `dotnet publish`; `dotnet build`/`dotnet run` stay JIT. Pass -p:PublishAot=false for a JIT publish -->
        <PublishAot>true</PublishAot>
        <!-- Surfaces trim/AOT analyzer warnings in regular `dotnet build`, not only at publish -->
        <IsAotCompatible>true</IsAotCompatible>
        <!-- Reflection-based System.Text.Json must stay off: any type missing from a JsonSerializerContext should fail loudly -->
        <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>

    <!-- Keep CLI code trim/AOT-safe: analyzer warnings fail `dotnet build`. Not applied at publish, where the AOT compiler
         also reports warnings from inside packages (Refit, Spectre) under the same codes -->
    <PropertyGroup Condition="'$(_IsPublishing)' != 'true'">
        <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2067;IL3050</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <!-- Spectre.Console.Cli discovers commands/settings via reflection and is not AOT-annotated -->
        <TrimmerRootAssembly Include="my-music"/>
        <TrimmerRootAssembly Include="Spectre.Console.Cli"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Json"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
        <PackageReference Include="Microsoft.Extensions.Logging"/>
        <PackageReference Include="Refit"/>
        <PackageReference Include="Refit.HttpClientFactory"/>
        <PackageReference Include="Spectre.Console"/>
        <PackageReference Include="Spectre.Console.Cli"/>
        <PackageReference Include="System.IO.Abstractions"/>
        <PackageReference Include="System.IO.Hashing"/>
        <PackageReference Include="TestableIO.System.IO.Abstractions"/>
        <PackageReference Include="OpenTelemetry.Extensions.Hosting"/>
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol"/>
        <PackageReference Include="OpenTelemetry.Instrumentation.Http"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="appsettings.development.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
